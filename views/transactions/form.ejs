<%# views/transactions/form.ejs %>
<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header">
                <h4 class="mb-0">
                    <i class="bi bi-<%= transaction ? 'pencil' : 'plus-circle' %>"></i>
                    <%= title %>
                </h4>
            </div>
            <div class="card-body">

                <% if (errors && errors.length > 0) { %>
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            <% errors.forEach(e => { %><li><%= e.msg %></li><% }); %>
                        </ul>
                    </div>
                <% } %>

                <form action="<%= transaction ? '/transactions/' + transaction.id + '/edit' : '/transactions' %>"
                      method="POST" novalidate>

                    <div class="mb-3">
                        <label class="form-label">Type *</label>
                        <select name="type" class="form-select" id="txType" required>
                            <option value="expense" <%= (oldInput.type === 'expense' || !oldInput.type) ? 'selected' : '' %>>
                                💸 Expense
                            </option>
                            <option value="income" <%= (oldInput.type === 'income') ? 'selected' : '' %>>
                                💰 Income
                            </option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Account *</label>
                        <select name="account_id" class="form-select" id="txAccount" required>
                            <option value="">Select account...</option>
                            <% accounts.forEach(acc => { %>
                                <option value="<%= acc.id %>"
                                        data-currency="<%= acc.currency %>"
                                        <%= (oldInput.account_id == acc.id) ? 'selected' : '' %>>
                                    <%= acc.name %> (<%= money(acc.balance, acc.currency) %>)
                                </option>
                            <% }); %>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Category *</label>
                        <select name="category_id" class="form-select" id="catSelect" required>
                            <option value="">Select category...</option>
                            <optgroup label="Expense Categories" id="expenseGroup">
                                <% categories.filter(c => c.type === 'expense').forEach(cat => { %>
                                    <option value="<%= cat.id %>" <%= (oldInput.category_id == cat.id) ? 'selected' : '' %>>
                                        <%= cat.icon ? cat.icon + ' ' : '' %><%= cat.name %>
                                    </option>
                                <% }); %>
                            </optgroup>
                            <optgroup label="Income Categories" id="incomeGroup">
                                <% categories.filter(c => c.type === 'income').forEach(cat => { %>
                                    <option value="<%= cat.id %>" <%= (oldInput.category_id == cat.id) ? 'selected' : '' %>>
                                        <%= cat.icon ? cat.icon + ' ' : '' %><%= cat.name %>
                                    </option>
                                <% }); %>
                            </optgroup>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" id="amountLabel">
                            Amount <span id="amountCurrency" class="text-secondary"></span> *
                        </label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-currency-exchange"></i></span>
                            <input type="number" name="amount" class="form-control" step="0.01" min="0.01"
                                   value="<%= oldInput.amount || '' %>" required placeholder="0.00">
                        </div>
                        <small class="form-text text-secondary">
                            Charged in the selected account's currency.
                        </small>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Date *</label>
                        <!-- hidden input carries the actual value submitted -->
                        <input type="hidden" name="date"
                               value="<%= oldInput.date || new Date().toISOString().slice(0,10) %>">
                        <!-- selected date label -->
                        <div class="mb-2 small fw-medium" id="cal-selected-label"
                             style="color:var(--brand)">
                            <%= oldInput.date
                                    ? new Date(oldInput.date).toLocaleDateString('en-GB', { weekday:'short', day:'numeric', month:'short', year:'numeric' })
                                    : 'Today' %>
                        </div>
                        <!-- calendar mount point -->
                        <div id="cal-picker" style="max-width:320px"></div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <input type="text" name="description" class="form-control" maxlength="200"
                               value="<%= oldInput.description || '' %>" placeholder="Optional note...">
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-check-lg"></i> Save
                        </button>
                        <a href="/transactions" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .cal-wrap { font-size: 14px; }
    .cal-nav {
        display: flex; align-items: center; justify-content: space-between;
        margin-bottom: 8px;
    }
    .cal-title { font-weight: 600; color: var(--ink); }
    .cal-grid {
        display: grid; grid-template-columns: repeat(7, 1fr);
        gap: 2px;
    }
    .cal-dow {
        text-align: center; font-size: 11px; font-weight: 600;
        color: var(--muted); padding: 4px 0; letter-spacing: .04em;
        text-transform: uppercase;
    }
    .cal-cell {
        position: relative; text-align: center; padding: 6px 2px;
        border-radius: 7px; cursor: pointer; font-variant-numeric: tabular-nums;
        color: var(--ink-soft); transition: background .12s;
    }
    .cal-cell:hover { background: var(--brand-soft); color: var(--brand-ink); }
    .cal-cell.cal-today { font-weight: 700; color: var(--brand); }
    .cal-cell.cal-selected {
        background: var(--brand); color: #fff; font-weight: 600;
    }
    .cal-cell.cal-selected:hover { background: var(--brand-ink); }
    .cal-cell.cal-empty { cursor: default; }
    .cal-dot {
        position: absolute; bottom: 3px; left: 50%; transform: translateX(-50%);
        width: 4px; height: 4px; border-radius: 50%;
        background: var(--brand); opacity: .7;
    }
    .cal-cell.cal-selected .cal-dot { background: #fff; opacity: .8; }
</style>
<script src="/js/calendar.js"></script>
<script>
(function () {
    const sel = document.getElementById('txAccount');
    const tag = document.getElementById('amountCurrency');
    if (!sel || !tag) return;
    function syncCurrency() {
        const opt = sel.options[sel.selectedIndex];
        const cur = opt && opt.dataset ? opt.dataset.currency : '';
        tag.textContent = cur ? '(' + cur + ')' : '';
    }
    sel.addEventListener('change', syncCurrency);
    syncCurrency();
})();
</script>

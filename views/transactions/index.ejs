<%# views/transactions/index.ejs %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="bi bi-arrow-left-right"></i> Transactions</h1>
  <div class="d-flex gap-2">
    <a href="/api/export/csv?<%= new URLSearchParams(filters).toString() %>" class="btn btn-outline-secondary">
      <i class="bi bi-download"></i> Export CSV
    </a>
    <a href="/api/export/json?<%= new URLSearchParams(filters).toString() %>" class="btn btn-outline-secondary">
      <i class="bi bi-filetype-json"></i> Export JSON
    </a>
    <a href="/transactions/new" class="btn btn-primary">
      <i class="bi bi-plus-lg"></i> Add Transaction
    </a>
  </div>
</div>

<!-- Filter Form -->
<form method="GET" action="/transactions">
  <div class="d-flex align-items-center gap-2 p-3 mb-3 rounded"
       style="background:var(--paper);border:1px solid var(--rule);">
    <input type="search" name="q" class="form-control form-control-sm rounded-pill" style="max-width:280px"
           placeholder="🔍 Search description…" value="<%= filters.q || '' %>">

    <% if (filters.dateFrom || filters.dateTo) { %>
      <span class="badge rounded-pill" style="background:var(--brand-soft);color:var(--brand-ink)">
        <%= filters.dateFrom || '…' %> → <%= filters.dateTo || '…' %>
        <a href="/transactions" class="text-decoration-none ms-1" style="color:inherit">×</a>
      </span>
    <% } %>

    <button class="btn btn-sm btn-outline-secondary rounded-pill" type="button"
            data-bs-toggle="collapse" data-bs-target="#advFilters">+ More filters</button>

    <a href="/transactions" class="ms-auto small text-secondary">Reset</a>
  </div>

  <div class="collapse <%= (filters.category_id || filters.type || filters.dateFrom || filters.dateTo) ? 'show' : '' %>"
       id="advFilters">
    <div class="card card-body mb-3">
      <div class="row g-3">
        <div class="col-md-2">
          <label class="form-label small">Date From</label>
          <input type="date" name="dateFrom" class="form-control form-control-sm" value="<%= filters.dateFrom || '' %>">
        </div>
        <div class="col-md-2">
          <label class="form-label small">Date To</label>
          <input type="date" name="dateTo" class="form-control form-control-sm" value="<%= filters.dateTo || '' %>">
        </div>
        <div class="col-md-3">
          <label class="form-label small">Category</label>
          <select name="category_id" class="form-select form-select-sm">
            <option value="">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat.id %>" <%= (filters.category_id == cat.id) ? 'selected' : '' %>>
                <%= cat.name %> (<%= cat.type %>)
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label small">Account</label>
          <select name="account_id" class="form-select form-select-sm">
            <option value="">All Accounts</option>
            <% accounts.forEach(acc => { %>
              <option value="<%= acc.id %>" <%= (filters.account_id == acc.id) ? 'selected' : '' %>>
                <%= acc.name %>
              </option>
            <% }); %>
          </select>
        </div>
        <div class="col-md-2">
          <label class="form-label small">Type</label>
          <select name="type" class="form-select form-select-sm">
            <option value="">All Types</option>
            <option value="income"  <%= (filters.type === 'income')  ? 'selected' : '' %>>Income</option>
            <option value="expense" <%= (filters.type === 'expense') ? 'selected' : '' %>>Expense</option>
          </select>
        </div>
        <div class="col-md-1 d-flex align-items-end">
          <button type="submit" class="btn btn-primary btn-sm w-100">Apply</button>
        </div>
      </div>
    </div>
  </div>
</form>

<!-- Transactions — grouped by day -->
<% if (transactions.length === 0) { %>
  <div class="text-center py-5 px-3">
    <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center"
         style="width:64px;height:64px;border-radius:16px;background:var(--brand-soft);color:var(--brand)">
      <i class="bi bi-arrow-left-right" style="font-size:28px"></i>
    </div>
    <h5 class="fw-semibold mb-1">No transactions yet</h5>
    <p class="text-secondary mb-3" style="max-width:34ch;margin-left:auto;margin-right:auto">
      Log your first transaction to start tracking your finances.
    </p>
    <a href="/transactions/new" class="btn btn-primary">Add transaction</a>
  </div>
<% } else { %>
  <%
    const grouped = transactions.reduce((acc, t) => {
      const k = dateLabel(t.date);
      (acc[k] = acc[k] || []).push(t);
      return acc;
    }, {});
    const allNet = transactions.reduce((s,t) => s + (t.type==='income' ? t.amount : -t.amount), 0);
  %>

  <div class="card">
    <% Object.entries(grouped).forEach(([day, items]) => {
      const net = items.reduce((s,t) => s + (t.type==='income' ? t.amount : -t.amount), 0); %>
    <div class="px-3 py-2 border-top d-flex justify-content-between"
         style="background:var(--paper);border-color:var(--rule)!important">
      <strong class="small text-uppercase" style="color:var(--muted);letter-spacing:.06em"><%= day %></strong>
      <span class="small num" style="color:var(--muted)">
        <%= items.length %> tx · <%= signed(Math.abs(net), net>=0 ? 'income' : 'expense') %>
      </span>
    </div>

    <% items.forEach(tx => { %>
      <div class="d-flex align-items-center gap-3 px-3 py-2 border-top" style="border-color:var(--rule)!important">
        <span class="badge rounded-pill d-inline-flex align-items-center gap-2"
              style="background:#f5f1e6;color:var(--ink-soft);border:1px solid var(--rule);font-weight:500">
          <span style="width:18px;height:18px;border-radius:50%;background:<%= tx.category_color || '#888' %>;
                  color:#fff;font-size:10px;display:inline-flex;align-items:center;justify-content:center">
            <%= (tx.category_name || '?').charAt(0) %>
          </span>
          <%= tx.category_name %>
        </span>
        <div class="flex-grow-1">
          <div class="fw-medium"><%= tx.description || '—' %></div>
          <div class="text-secondary small"><%= tx.account_name %></div>
        </div>
        <div class="num text-end"
             style="font-family:'JetBrains Mono',monospace;min-width:140px;
                    color:<%= tx.type==='income' ? 'var(--good)' : 'var(--ink)' %>">
          <%= signed(tx.amount, tx.type, tx.currency) %>
        </div>
        <div class="d-flex gap-1">
          <a href="/transactions/<%= tx.id %>/edit" class="btn btn-sm btn-outline-secondary">✎</a>
          <form action="/transactions/<%= tx.id %>/delete" method="POST" class="d-inline"
                onsubmit="return confirm('Delete this transaction?')">
            <button class="btn btn-sm btn-outline-danger">×</button>
          </form>
        </div>
      </div>
    <% }); %>
    <% }); %>

    <div class="px-3 py-2 border-top d-flex justify-content-between small"
         style="border-color:var(--rule)!important;color:var(--muted)">
      <span>Showing <%= transactions.length %> transaction<%= transactions.length !== 1 ? 's' : '' %></span>
      <span class="num">Net: <%= signed(Math.abs(allNet), allNet>=0 ? 'income' : 'expense') %></span>
    </div>
  </div>
<% } %>
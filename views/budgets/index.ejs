<%# views/budgets/index.ejs %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <p class="text-uppercase fw-semibold mb-1" style="color:var(--brand);font-size:11px;letter-spacing:.1em;">Monthly limits</p>
  <h1 class="mb-0" style="letter-spacing:-0.02em">Budgets</h1>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBudgetModal">
    <i class="bi bi-plus-lg"></i> Set Budget
  </button>
</div>

<%# Flash errors %>
<% if (errors && errors.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <ul class="mb-0">
      <% errors.forEach(e => { %><li><%= e.msg %></li><% }); %>
    </ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Month selector — stepper -->
<div class="d-flex align-items-center gap-3 mb-4 p-3 rounded"
     style="background:var(--paper);border:1px solid var(--rule);width:fit-content">
  <%
  const [yr, mo] = currentMonth.split('-').map(Number);
  const prev = new Date(yr, mo - 2, 1);
  const next = new Date(yr, mo, 1);
  const prevStr = prev.toISOString().slice(0,7);
  const nextStr = next.toISOString().slice(0,7);
  const monthName = new Date(yr, mo - 1, 1).toLocaleDateString('en-GB', { month:'long', year:'numeric' });
  %>
  <a href="/budgets?month=<%= prevStr %>" class="btn btn-sm btn-outline-secondary">‹</a>
  <span class="fw-semibold" style="min-width:140px;text-align:center"><%= monthName %></span>
  <a href="/budgets?month=<%= nextStr %>" class="btn btn-sm btn-outline-secondary">›</a>
</div>

<!-- Summary stats -->
<% if (budgets.length > 0) { %>
  <%
    const totalBudget = budgets.reduce((s,b) => s + b.limit_amount, 0);
    const totalSpent  = budgets.reduce((s,b) => s + b.spent, 0);
  %>
  <div class="row g-3 mb-4">
    <div class="col-md-4"><div class="card p-3">
        <div class="small" style="color:var(--muted)">Total budgeted</div>
        <div class="h4 mb-0 num"><%= money(totalBudget) %></div>
      </div></div>
    <div class="col-md-4"><div class="card p-3">
        <div class="small" style="color:var(--muted)">Spent this month</div>
        <div class="h4 mb-0 num" style="color:var(--bad)"><%= money(totalSpent) %></div>
      </div></div>
    <div class="col-md-4"><div class="card p-3">
        <div class="small" style="color:var(--muted)">Remaining</div>
        <div class="h4 mb-0 num" style="color:var(--good)"><%= money(totalBudget - totalSpent) %></div>
      </div></div>
  </div>
<% } %>


<!-- Budget list -->
<% if (budgets.length === 0) { %>
  <%- include('../partials/empty-state', {
  icon:     'bi-piggy-bank',
  title:    'No budgets for this month',
  message:  'Set monthly limits per category to keep your spending in check.',
  ctaLabel: 'Set your first budget',
  ctaUrl:   '#addBudgetModal'
  }) %>
<% } else { %>
  <div class="row g-3">
    <% budgets.forEach(b => { %>
      <div class="col-md-6">
        <div class="card h-100 <%= b.over_limit ? 'over-budget' : '' %>">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <span class="fs-5">
                  <% if (b.icon) { %><%= b.icon %> <% } %>
                  <strong><%= b.category_name %></strong>
                </span>
                <div class="small" style="color:var(--muted)"><%= b.month %></div>
              </div>
              <div class="d-flex gap-1 align-items-center">
                <% if (b.over_limit) { %>
                  <span class="badge rounded-pill" style="background:var(--bad-soft);color:var(--bad);font-weight:500">⚠ Over</span>
                <% } %>
                <button class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="modal" data-bs-target="#editBudgetModal"
                        data-id="<%= b.id %>"
                        data-limit="<%= b.limit_amount %>"
                        data-month="<%= b.month %>"
                        data-name="<%= b.category_name %>"
                        title="Edit limit">
                  <i class="bi bi-pencil"></i>
                </button>
                <!-- Delete button -->
                <form action="/budgets/<%= b.id %>/delete" method="POST" class="d-inline"
                      onsubmit="return confirm('Remove this budget?')">
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </div>
            </div>

            <!-- Progress bar -->
            <div class="progress mb-2" role="progressbar">
              <div class="progress-bar"
                   style="width: <%= Math.min(b.percent, 100) %>%;
                           background: <%= b.over_limit ? 'var(--bad)' :
                           b.percent > 75 ? 'linear-gradient(90deg, var(--brand) 0%, var(--warn) 100%)' :
                                   'var(--brand)' %>">
              </div>
            </div>

            <!-- Amounts -->
            <div class="d-flex justify-content-between small" style="color:var(--muted)">
              <span>Spent: <strong style="color:<%= b.over_limit ? 'var(--bad)' : 'var(--ink)' %>">
                <%= money(b.spent) %>
              </strong></span>
              <span>Limit: <strong style="color:var(--ink)"><%= money(b.limit_amount) %></strong></span>
              <span>Left: <strong style="color:<%= (b.limit_amount - b.spent) < 0 ? 'var(--bad)' : 'var(--good)' %>">
                <%= money(b.limit_amount - b.spent) %>
              </strong></span>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<!-- Add Budget Modal -->
<div class="modal fade" id="addBudgetModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/budgets" method="POST" novalidate>
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Set Budget</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Expense Category *</label>
            <select name="category_id" class="form-select" required>
              <option value="">Select category...</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>">
                  <%= cat.icon ? cat.icon + ' ' : '' %><%= cat.name %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Month *</label>
            <input type="month" name="month" class="form-control" required value="<%= currentMonth %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Monthly Limit (UAH) *</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-currency-exchange"></i></span>
              <input type="number" name="limit_amount" class="form-control"
                     step="0.01" min="0.01" required placeholder="0.00"
                     value="<%= oldInput.limit_amount || '' %>">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Budget</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Budget Modal -->
<div class="modal fade" id="editBudgetModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="editBudgetForm" method="POST" novalidate>
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Budget Limit</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted mb-3">
            Category: <strong id="editBudgetCatName"></strong>
          </p>
          <input type="hidden" name="month" id="editBudgetMonth">
          <div class="mb-3">
            <label class="form-label">New Monthly Limit (UAH) *</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-currency-exchange"></i></span>
              <input type="number" name="limit_amount" id="editBudgetLimit"
                     class="form-control" step="0.01" min="0.01" required placeholder="0.00">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Update Limit</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.getElementById('editBudgetModal').addEventListener('show.bs.modal', function(event) {
    const btn = event.relatedTarget;
    document.getElementById('editBudgetForm').action = `/budgets/${btn.dataset.id}/edit`;
    document.getElementById('editBudgetLimit').value  = btn.dataset.limit;
    document.getElementById('editBudgetMonth').value  = btn.dataset.month;
    document.getElementById('editBudgetCatName').textContent = btn.dataset.name;
  });
</script>
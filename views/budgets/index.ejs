<%# views/budgets/index.ejs %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <h1><i class="bi bi-piggy-bank"></i> Budgets</h1>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBudgetModal">
    <i class="bi bi-plus-lg"></i> Set Budget
  </button>
</div>

<%# Flash errors %>
<% if (errors && errors.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <ul class="mb-0">
      <% errors.forEach(e => { %><li><%= e.msg %></li><% }); %>
    </ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Month selector -->
<div class="card mb-4">
  <div class="card-body">
    <form method="GET" action="/budgets" class="d-flex align-items-center gap-3">
      <label class="form-label mb-0 fw-bold">Month:</label>
      <input type="month" name="month" class="form-control" style="width:180px"
             value="<%= currentMonth %>" onchange="this.form.submit()">
    </form>
  </div>
</div>

<!-- Budget list -->
<% if (budgets.length === 0) { %>
  <div class="card">
    <div class="card-body text-center py-5">
      <i class="bi bi-piggy-bank fs-1 text-muted"></i>
      <p class="text-muted mt-3">No budgets set for <strong><%= currentMonth %></strong>.</p>
      <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addBudgetModal">
        <i class="bi bi-plus-lg"></i> Set your first budget
      </button>
    </div>
  </div>
<% } else { %>
  <div class="row g-3">
    <% budgets.forEach(b => { %>
      <div class="col-md-6">
        <div class="card shadow-sm h-100">
          <div class="card-body">
            <div class="d-flex justify-content-between align-items-start mb-2">
              <div>
                <span class="fs-5">
                  <% if (b.icon) { %><%= b.icon %> <% } %>
                  <strong><%= b.category_name %></strong>
                </span>
                <div class="text-muted small"><%= b.month %></div>
              </div>
              <div class="d-flex gap-1 align-items-center">
                <% if (b.over_limit) { %>
                  <span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> Over budget!</span>
                <% } %>
                <!-- Edit button -->
                <button class="btn btn-sm btn-outline-secondary"
                        data-bs-toggle="modal" data-bs-target="#editBudgetModal"
                        data-id="<%= b.id %>"
                        data-limit="<%= b.limit_amount %>"
                        data-month="<%= b.month %>"
                        data-name="<%= b.category_name %>"
                        title="Edit limit">
                  <i class="bi bi-pencil"></i>
                </button>
                <!-- Delete button -->
                <form action="/budgets/<%= b.id %>/delete" method="POST" class="d-inline"
                      onsubmit="return confirm('Remove this budget?')">
                  <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                </form>
              </div>
            </div>

            <!-- Progress bar -->
            <div class="progress mb-2" style="height:22px;">
              <div class="progress-bar <%= b.over_limit ? 'bg-danger' : (b.percent > 75 ? 'bg-warning' : 'bg-success') %>"
                   role="progressbar"
                   style="width: <%= b.percent %>%"
                   aria-valuenow="<%= b.percent %>"
                   aria-valuemin="0" aria-valuemax="100">
                <%= b.percent %>%
              </div>
            </div>

            <!-- Amounts -->
            <div class="d-flex justify-content-between small">
              <span class="text-muted">
                Spent: <strong class="<%= b.over_limit ? 'text-danger' : '' %>">
                  <%= b.spent.toFixed(2) %> UAH
                </strong>
              </span>
              <span class="text-muted">
                Limit: <strong><%= b.limit_amount.toFixed(2) %> UAH</strong>
              </span>
              <span class="text-muted">
                Left: <strong class="<%= (b.limit_amount - b.spent) < 0 ? 'text-danger' : 'text-success' %>">
                  <%= (b.limit_amount - b.spent).toFixed(2) %> UAH
                </strong>
              </span>
            </div>
          </div>
        </div>
      </div>
    <% }); %>
  </div>
<% } %>

<!-- Add Budget Modal -->
<div class="modal fade" id="addBudgetModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/budgets" method="POST" novalidate>
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Set Budget</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Expense Category *</label>
            <select name="category_id" class="form-select" required>
              <option value="">Select category...</option>
              <% categories.forEach(cat => { %>
                <option value="<%= cat.id %>">
                  <%= cat.icon ? cat.icon + ' ' : '' %><%= cat.name %>
                </option>
              <% }); %>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Month *</label>
            <input type="month" name="month" class="form-control" required value="<%= currentMonth %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Monthly Limit (UAH) *</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-currency-exchange"></i></span>
              <input type="number" name="limit_amount" class="form-control"
                     step="0.01" min="0.01" required placeholder="0.00"
                     value="<%= oldInput.limit_amount || '' %>">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Budget</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Budget Modal -->
<div class="modal fade" id="editBudgetModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="editBudgetForm" method="POST" novalidate>
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Budget Limit</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p class="text-muted mb-3">
            Category: <strong id="editBudgetCatName"></strong>
          </p>
          <input type="hidden" name="month" id="editBudgetMonth">
          <div class="mb-3">
            <label class="form-label">New Monthly Limit (UAH) *</label>
            <div class="input-group">
              <span class="input-group-text"><i class="bi bi-currency-exchange"></i></span>
              <input type="number" name="limit_amount" id="editBudgetLimit"
                     class="form-control" step="0.01" min="0.01" required placeholder="0.00">
            </div>
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Update Limit</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  document.getElementById('editBudgetModal').addEventListener('show.bs.modal', function(event) {
    const btn = event.relatedTarget;
    document.getElementById('editBudgetForm').action = `/budgets/${btn.dataset.id}/edit`;
    document.getElementById('editBudgetLimit').value  = btn.dataset.limit;
    document.getElementById('editBudgetMonth').value  = btn.dataset.month;
    document.getElementById('editBudgetCatName').textContent = btn.dataset.name;
  });
</script>
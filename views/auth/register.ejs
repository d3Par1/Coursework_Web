<div class="row g-0 my-n4" style="min-height:calc(100vh - 120px)">
  <!-- LEFT hero -->
  <div class="col-md-5 d-none d-md-flex flex-column justify-content-between p-5"
       style="background:var(--brand);color:#fff;
              background-image: radial-gradient(rgba(255,255,255,0.04) 1px, transparent 1px);
              background-size: 24px 24px;">
    <div class="fw-bold fs-5 d-flex align-items-center gap-2">
      <span style="width:42px;height:42px;border-radius:11px;background:#fff;color:var(--brand);
                   display:inline-flex;align-items:center;justify-content:center;
                   font-family:'JetBrains Mono',monospace;font-weight:700;font-size:14px">FM</span>
      Finance Manager
    </div>
    <div>
      <h1 style="font-family:'Instrument Serif',serif;font-weight:400;font-size:60px;line-height:1.05;letter-spacing:-0.01em">
        Start tracking<br>
        in under a <em style="font-style:italic">minute</em>.
      </h1>
      <p style="opacity:.85;max-width:38ch;font-size:15px;line-height:1.5;margin-top:1.5rem">
        Add your accounts, log a few transactions, see where your money actually goes.
        No imports, no setup wizards — just type and it works.
      </p>
    </div>
    <small style="opacity:.8;font-family:'JetBrains Mono',monospace;letter-spacing:.04em;font-size:11px">
      &#x1F512; Free · open source · runs locally
    </small>
  </div>

  <!-- RIGHT form -->
  <div class="col-md-7 d-flex align-items-center justify-content-center p-5" style="background:var(--paper)">
    <form action="/auth/register" method="POST" class="needs-validation w-100" novalidate style="max-width:420px">
      <p class="text-uppercase fw-semibold mb-1" style="color:var(--brand);font-size:11px;letter-spacing:.14em;">Get started</p>
      <h2 class="fw-bold mb-2" style="letter-spacing:-0.02em;font-size:34px">Create your account</h2>
      <p class="text-secondary mb-4">Takes about 30 seconds to set up.</p>

      <div class="mb-3">
        <label for="name" class="form-label small fw-semibold">Name</label>
        <input type="text" id="name" name="name" autocomplete="name"
               placeholder="Your name"
               class="form-control py-2 <%= errors && errors.find(e => e.path === 'name') ? 'is-invalid' : '' %>"
               value="<%= typeof oldInput !== 'undefined' && oldInput.name ? oldInput.name : '' %>" required>
        <div class="invalid-feedback">
          <%= errors && errors.find(e => e.path === 'name') ? errors.find(e => e.path === 'name').msg : 'Name is required' %>
        </div>
      </div>

      <div class="mb-3">
        <label for="email" class="form-label small fw-semibold">Email address</label>
        <input type="email" id="email" name="email" autocomplete="email"
               placeholder="you@example.com"
               class="form-control py-2 <%= errors && errors.find(e => e.path === 'email') ? 'is-invalid' : '' %>"
               value="<%= typeof oldInput !== 'undefined' && oldInput.email ? oldInput.email : '' %>" required>
        <div class="invalid-feedback">
          <%= errors && errors.find(e => e.path === 'email') ? errors.find(e => e.path === 'email').msg : 'Please enter a valid email address' %>
        </div>
      </div>

      <div class="row g-3 mb-3">
        <div class="col-6">
          <label for="password" class="form-label small fw-semibold">Password</label>
          <input type="password" id="password" name="password" autocomplete="new-password" minlength="6"
                 placeholder="••••••••"
                 class="form-control py-2 <%= errors && errors.find(e => e.path === 'password') ? 'is-invalid' : '' %>" required>
          <div class="invalid-feedback">
            <%= errors && errors.find(e => e.path === 'password') ? errors.find(e => e.path === 'password').msg : 'At least 6 characters' %>
          </div>
        </div>
        <div class="col-6">
          <label for="confirmPassword" class="form-label small fw-semibold">Confirm</label>
          <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password"
                 placeholder="••••••••"
                 class="form-control py-2 <%= errors && errors.find(e => e.path === 'confirmPassword') ? 'is-invalid' : '' %>" required>
          <div class="invalid-feedback">
            <%= errors && errors.find(e => e.path === 'confirmPassword') ? errors.find(e => e.path === 'confirmPassword').msg : 'Please confirm' %>
          </div>
        </div>
      </div>

      <button class="btn btn-primary w-100 py-2 mb-3" type="submit" style="font-size:15px">Create account</button>

      <%- include('../partials/provider-buttons') %>

      <p class="text-center text-secondary small mb-0 mt-4">
        Already have an account?
        <a href="/auth/login" class="text-decoration-none" style="color:var(--brand);font-weight:600">Sign in</a>
      </p>
    </form>
  </div>
</div>

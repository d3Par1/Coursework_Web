<div class="d-flex justify-content-between align-items-end mb-4 flex-wrap gap-2">
  <div>
    <p class="text-uppercase fw-semibold mb-1" style="color:var(--brand);font-size:11px;letter-spacing:.1em;">Overview</p>
    <h1 class="mb-0" style="letter-spacing:-0.02em;padding-bottom:6px;">Dashboard</h1>
  </div>
  <a href="/transactions/new" class="btn btn-primary">+ New transaction</a>
</div>

<div class="row g-3 mb-4">
  <div class="col-md-4">
    <div class="card h-100 p-3">
      <div class="small text-secondary text-uppercase fw-semibold" style="letter-spacing:.06em;font-size:11px">Total balance</div>
      <div class="h3 mb-1 num mt-1" style="color:var(--brand-ink)"><%= money(total) %></div>
      <div class="small text-secondary">Across <%= accounts.length %> account<%= accounts.length === 1 ? '' : 's' %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 p-3">
      <div class="small text-secondary text-uppercase fw-semibold" style="letter-spacing:.06em;font-size:11px">Income this month</div>
      <div class="h3 mb-1 num mt-1 text-success"><%= signed(monthTotals.income, 'income') %></div>
      <div class="small text-secondary"><%= month %></div>
    </div>
  </div>
  <div class="col-md-4">
    <div class="card h-100 p-3">
      <div class="small text-secondary text-uppercase fw-semibold" style="letter-spacing:.06em;font-size:11px">Expenses this month</div>
      <div class="h3 mb-1 num mt-1" style="color:var(--bad)"><%= signed(monthTotals.expense, 'expense') %></div>
      <div class="small text-secondary"><%= month %></div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-8">
    <div class="card h-100 d-flex flex-column">
      <div class="card-header d-flex justify-content-between align-items-center bg-transparent" style="border-color:var(--rule)">
        <h5 class="mb-0">Recent activity</h5>
        <a href="/transactions" class="btn btn-sm btn-outline-secondary">View all</a>
      </div>
      <div class="card-body p-0">
        <% if (recent.length === 0) { %>
          <%- include('partials/empty-state', { icon:'bi-arrow-left-right', title:'No transactions yet', message:'Log your first transaction to start tracking your finances.', ctaLabel:'Add transaction', ctaUrl:'/transactions/new' }) %>
        <% } else {
             const grouped = recent.reduce((acc, t) => {
               const k = dateLabel(t.date);
               (acc[k] = acc[k] || []).push(t); return acc;
             }, {}); %>
          <% Object.entries(grouped).forEach(([day, items]) => {
               const dayNet = items.reduce((s,t) => s + (t.type==='income'? t.amount : -t.amount), 0); %>
            <div class="px-3 py-2 d-flex justify-content-between small text-uppercase fw-semibold"
                 style="color:var(--muted);letter-spacing:.08em;background:var(--paper);font-size:11px">
              <span><%= day %></span>
              <span class="num" style="color:<%= dayNet >= 0 ? 'var(--good)' : 'var(--ink-soft)' %>">
                <%= signed(Math.abs(dayNet), dayNet >= 0 ? 'income' : 'expense') %>
              </span>
            </div>
            <% items.forEach(t => { %>
              <div class="d-flex align-items-center gap-3 px-3 py-2 border-top" style="border-color:var(--rule)!important">
                <span style="width:32px;height:32px;border-radius:9px;background:<%= t.category_color || '#888' %>;
                             color:#fff;display:inline-flex;align-items:center;justify-content:center;
                             font-size:13px;font-weight:600;">
                  <%= (t.category_name || '?').charAt(0).toUpperCase() %>
                </span>
                <div class="flex-grow-1">
                  <div class="fw-medium"><%= t.description || t.category_name %></div>
                  <div class="text-secondary small"><%= t.category_name %> · <%= t.account_name %></div>
                </div>
                <div class="num" style="color:<%= t.type==='income' ? 'var(--good)' : 'var(--ink)' %>">
                  <%= signed(t.amount, t.type, t.currency) %>
                </div>
              </div>
            <% }); %>
          <% }); %>
        <% } %>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card h-100 d-flex flex-column">
      <div class="card-header bg-transparent" style="border-color:var(--rule)">
        <h5 class="mb-0">Exchange rates</h5>
      </div>
      <div class="card-body">
        <% if (rates) { %>
          <p class="small text-secondary mb-3">1 UAH equals</p>
          <ul class="list-unstyled mb-3">
            <% rates.forEach(r => { %>
              <li class="d-flex justify-content-between align-items-center py-2 border-bottom" style="border-color:var(--rule)!important">
                <span class="fw-semibold"><%= r.code %></span>
                <span class="num small">
                  <%= r.rate.toFixed(4) %>
                  <span class="text-secondary ms-1">≈ <%= r.inverse.toFixed(2) %> ₴</span>
                </span>
              </li>
            <% }); %>
          </ul>
          <p class="small text-secondary mb-0" style="font-size:11px">
            Source: open.er-api.com (cached 1h)
          </p>
        <% } else { %>
          <p class="text-secondary small mb-0">
            Unable to fetch rates<% if (ratesError) { %>: <%= ratesError %><% } %>
          </p>
        <% } %>
      </div>
    </div>
  </div>
</div>

<div class="row g-3 mb-4">
  <div class="col-lg-5">
    <div class="card h-100 d-flex flex-column">
      <div class="card-header bg-transparent" style="border-color:var(--rule)">
        <h5 class="mb-0">Expenses by category — <%= month %></h5>
      </div>
      <div class="card-body">
        <div style="position: relative; height: 320px;">
          <canvas id="chart-categories"></canvas>
        </div>
      </div>
    </div>
  </div>

  <div class="col-lg-7">
    <div class="card h-100 d-flex flex-column">
      <div class="card-header bg-transparent" style="border-color:var(--rule)">
        <h5 class="mb-0">Income vs expense (₴) — last 6 months</h5>
      </div>
      <div class="card-body">
        <div style="position: relative; height: 320px;">
          <canvas id="chart-monthly"></canvas>
        </div>
      </div>
    </div>
  </div>
</div>

<script src="/js/dashboard-charts.js" defer></script>

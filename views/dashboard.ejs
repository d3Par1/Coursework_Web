<h1 class="mb-4"><i class="bi bi-speedometer2"></i> Dashboard</h1>

<div class="row g-4 mb-4">
  <!-- Total Balance Card -->
  <div class="col-md-4">
    <div class="card border-primary h-100">
      <div class="card-body text-center">
        <h5 class="card-title text-muted">Total Balance</h5>
        <h2 class="card-text text-primary">0.00 UAH</h2>
        <small class="text-muted">Across all accounts</small>
      </div>
    </div>
  </div>

  <!-- Income Summary Card -->
  <div class="col-md-4">
    <div class="card border-success h-100">
      <div class="card-body text-center">
        <h5 class="card-title text-muted">Income This Month</h5>
        <h2 class="card-text text-success">+0.00 UAH</h2>
        <small class="text-muted">March 2026</small>
      </div>
    </div>
  </div>

  <!-- Expense Summary Card -->
  <div class="col-md-4">
    <div class="card border-danger h-100">
      <div class="card-body text-center">
        <h5 class="card-title text-muted">Expenses This Month</h5>
        <h2 class="card-text text-danger">-0.00 UAH</h2>
        <small class="text-muted">March 2026</small>
      </div>
    </div>
  </div>
</div>

<!-- Recent Transactions -->
<div class="card">
  <div class="card-header d-flex justify-content-between align-items-center">
    <h5 class="mb-0">Recent Transactions</h5>
    <a href="/transactions" class="btn btn-sm btn-outline-primary">View All</a>
  </div>
  <div class="card-body">
    <p class="text-muted text-center py-3">No transactions yet. Add your first transaction to get started.</p>
  </div>
</div>

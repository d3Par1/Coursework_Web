<%# views/categories/index.ejs %>
<div class="d-flex justify-content-between align-items-center mb-4">
  <p class="text-uppercase fw-semibold mb-1" style="color:var(--brand);font-size:11px;letter-spacing:.1em;">Organize</p>
  <h1 class="mb-0" style="letter-spacing:-0.02em">Categories</h1>
  <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#addCategoryModal">
    <i class="bi bi-plus-lg"></i> Add Category
  </button>
</div>

<%# Flash errors %>
<% if (errors && errors.length > 0) { %>
  <div class="alert alert-danger alert-dismissible fade show">
    <ul class="mb-0">
      <% errors.forEach(e => { %><li><%= e.msg %></li><% }); %>
    </ul>
    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
  </div>
<% } %>

<!-- Tabs -->
<ul class="nav nav-tabs mb-4" role="tablist">
  <li class="nav-item" role="presentation">
    <button class="nav-link active" data-bs-toggle="tab" data-bs-target="#exp-tab" type="button" role="tab">
      Expense <span class="badge rounded-pill ms-1" style="background:var(--brand-soft);color:var(--brand-ink)"><%= expense.length %></span>
    </button>
  </li>
  <li class="nav-item" role="presentation">
    <button class="nav-link" data-bs-toggle="tab" data-bs-target="#inc-tab" type="button" role="tab">
      Income <span class="badge rounded-pill ms-1" style="background:#f1ede3;color:var(--ink-soft)"><%= income.length %></span>
    </button>
  </li>
</ul>

<div class="tab-content">
  <% [['exp', expense], ['inc', income]].forEach(([tab, list], i) => { %>
    <div class="tab-pane fade <%= i===0 ? 'show active' : '' %>" id="<%= tab %>-tab" role="tabpanel">
      <% if (list.length === 0) { %>
        <%- include('../partials/empty-state', {
        icon:     'bi-tags',
        title:    'No categories yet',
        message:  'Add your first category to organize transactions.',
        ctaLabel: '+ New category',
        ctaUrl:   '#addCategoryModal'
        }) %>
      <% } else { %>
        <div class="row g-3">
          <% list.forEach(cat => { %>
            <div class="col-md-3 col-sm-6">
              <div class="card h-100 p-3 position-relative">
                <div style="width:42px;height:42px;border-radius:11px;background:<%= cat.color || '#888' %>;
                        color:#fff;display:inline-flex;align-items:center;justify-content:center;
                        font-size:18px;font-weight:600;margin-bottom:12px">
                  <%= cat.icon || cat.name.charAt(0) %>
                </div>
                <div class="fw-semibold"><%= cat.name %></div>
                <div class="small mt-auto pt-2 border-top mt-3"
                     style="color:var(--muted);border-color:var(--rule)!important">
                  <%= cat.monthly_total ? money(cat.monthly_total) : '—' %>
                </div>
                <% if (!cat.user_id) { %>
                  <span class="position-absolute top-0 end-0 m-2 badge rounded-pill"
                        style="background:#f1ede3;color:var(--muted);font-weight:400">system</span>
                <% } else { %>
                  <div class="position-absolute top-0 end-0 m-2 d-flex gap-1">
                    <button class="btn btn-sm btn-outline-secondary py-0 px-1"
                            data-bs-toggle="modal" data-bs-target="#editModal"
                            data-id="<%= cat.id %>" data-name="<%= cat.name %>"
                            data-type="<%= cat.type %>" data-icon="<%= cat.icon||'' %>"
                            data-color="<%= cat.color||'' %>">✎</button>
                    <form action="/categories/<%= cat.id %>/delete" method="POST" class="d-inline"
                          onsubmit="return confirm('Delete category \'<%= cat.name %>\'?')">
                      <button class="btn btn-sm btn-outline-danger py-0 px-1">×</button>
                    </form>
                  </div>
                <% } %>
              </div>
            </div>
          <% }); %>
          <div class="col-md-3 col-sm-6">
            <button class="card h-100 p-3 d-flex align-items-center justify-content-center text-secondary w-100"
                    style="border:1.5px dashed var(--rule-strong);background:transparent;min-height:128px"
                    data-bs-toggle="modal" data-bs-target="#addCategoryModal">
              <span>+ Add category</span>
            </button>
          </div>
        </div>
      <% } %>
    </div>
  <% }); %>
</div>



<!-- Add Category Modal -->
<div class="modal fade" id="addCategoryModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form action="/categories" method="POST" novalidate>
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-plus-circle"></i> Add Category</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Name *</label>
            <input type="text" name="name" class="form-control" required value="<%= oldInput.name || '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Type *</label>
            <select name="type" class="form-select" required>
              <option value="expense" <%= (oldInput.type === 'expense') ? 'selected' : '' %>>Expense</option>
              <option value="income"  <%= (oldInput.type === 'income')  ? 'selected' : '' %>>Income</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Icon (emoji or text)</label>
            <input type="text" name="icon" class="form-control" placeholder="🍔" value="<%= oldInput.icon || '' %>">
          </div>
          <div class="mb-3">
            <label class="form-label">Color</label>
            <input type="color" name="color" class="form-control form-control-color" value="<%= oldInput.color || '#6c757d' %>">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Save Category</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- Edit Category Modal -->
<div class="modal fade" id="editModal" tabindex="-1">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="editForm" action="" method="POST" novalidate>
        <div class="modal-header">
          <h5 class="modal-title"><i class="bi bi-pencil"></i> Edit Category</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Name *</label>
            <input type="text" name="name" id="editName" class="form-control" required>
          </div>
          <div class="mb-3">
            <label class="form-label">Type *</label>
            <select name="type" id="editType" class="form-select" required>
              <option value="expense">Expense</option>
              <option value="income">Income</option>
            </select>
          </div>
          <div class="mb-3">
            <label class="form-label">Icon</label>
            <input type="text" name="icon" id="editIcon" class="form-control">
          </div>
          <div class="mb-3">
            <label class="form-label">Color</label>
            <input type="color" name="color" id="editColor" class="form-control form-control-color">
          </div>
        </div>
        <div class="modal-footer">
          <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
          <button type="submit" class="btn btn-primary">Update</button>
        </div>
      </form>
    </div>
  </div>
</div>

<script>
  // Populate edit modal from data attributes
  document.getElementById('editModal').addEventListener('show.bs.modal', function(event) {
    const btn = event.relatedTarget;
    document.getElementById('editForm').action = `/categories/${btn.dataset.id}/edit`;
    document.getElementById('editName').value  = btn.dataset.name;
    document.getElementById('editType').value  = btn.dataset.type;
    document.getElementById('editIcon').value  = btn.dataset.icon;
    document.getElementById('editColor').value = btn.dataset.color || '#6c757d';
  });
</script>

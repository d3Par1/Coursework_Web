<%# views/accounts/index.ejs %>
<%
  const filterType = (locals.filters && locals.filters.type) || '';
  const grouped = accounts.reduce((acc, a) => {
    (acc[a.type] = acc[a.type] || []).push(a);
    return acc;
  }, {});
  const typeOrder = ['cash', 'card', 'savings'];
  const visible = filterType ? accounts.filter((a) => a.type === filterType) : accounts;
%>
<div class="d-flex justify-content-between align-items-end mb-4">
  <div>
    <p class="text-uppercase fw-semibold mb-1" style="color:var(--brand);font-size:11px;letter-spacing:.1em;">Wallets</p>
    <h1 class="mb-0" style="letter-spacing:-0.02em">Accounts</h1>
  </div>
  <a href="/accounts/new" class="btn btn-primary">+ New account</a>
</div>

<div class="row g-4">
  <aside class="col-lg-3">
    <div class="card border-0 shadow-sm" style="background:var(--paper)">
      <div class="card-body p-3">
        <p class="text-uppercase fw-semibold mb-2" style="color:var(--brand);font-size:11px;letter-spacing:.14em;">Filter by type</p>
        <a href="/accounts"
           class="d-flex justify-content-between align-items-center py-2 border-bottom text-decoration-none"
           style="color:<%= !filterType ? 'var(--brand)' : 'var(--ink-soft)' %>;border-color:var(--rule)!important;font-weight:<%= !filterType ? '600' : '500' %>;">
          <span>All accounts</span>
          <span class="badge rounded-pill" style="background:var(--brand-soft);color:var(--brand-ink);font-weight:600;"><%= accounts.length %></span>
        </a>
        <% typeOrder.forEach((type) => { %>
          <% const list = grouped[type] || []; %>
          <a href="/accounts?type=<%= type %>"
             class="d-flex justify-content-between align-items-center py-2 border-bottom text-decoration-none"
             style="color:<%= filterType === type ? 'var(--brand)' : 'var(--ink-soft)' %>;border-color:var(--rule)!important;font-weight:<%= filterType === type ? '600' : '500' %>;">
            <span class="text-capitalize"><%= type %></span>
            <span class="badge rounded-pill" style="background:var(--brand-soft);color:var(--brand-ink);font-weight:600;"><%= list.length %></span>
          </a>
        <% }); %>
        <% if (accounts.length > 0) { %>
          <div class="mt-3 pt-2 small" style="color:var(--muted);">
            <div class="text-uppercase fw-semibold" style="color:var(--brand);font-size:11px;letter-spacing:.14em;">Total balance</div>
            <div class="num" style="font-size:18px;color:var(--ink);font-weight:600;margin-top:4px;"><%= money(total) %></div>
          </div>
        <% } %>
      </div>
    </div>
  </aside>

  <main class="col-lg-9">
    <div class="card border-0 shadow-sm" style="background:var(--paper)">
      <div class="card-body p-0">
        <% if (visible.length === 0) { %>
          <div class="text-center py-5 px-3">
            <div class="mx-auto mb-3 d-inline-flex align-items-center justify-content-center"
                 style="width:64px;height:64px;border-radius:16px;background:var(--brand-soft);color:var(--brand);">
              <i class="bi bi-wallet2" style="font-size:28px"></i>
            </div>
            <h5 class="fw-semibold mb-1"><%= filterType ? 'No ' + filterType + ' accounts' : 'No accounts yet' %></h5>
            <p class="text-secondary mb-3" style="max-width:34ch;margin-left:auto;margin-right:auto">
              <% if (filterType) { %>Switch to "All accounts" or create one of this type.<% } else { %>Create your first account to start tracking finances.<% } %>
            </p>
            <a href="/accounts/new" class="btn btn-primary">+ New account</a>
          </div>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-hover mb-0">
              <thead style="background:var(--surface);">
                <tr>
                  <th>Name</th>
                  <th>Type</th>
                  <th>Currency</th>
                  <th class="text-end">Balance</th>
                  <th class="text-end">Actions</th>
                </tr>
              </thead>
              <tbody>
                <% visible.forEach((a) => { %>
                  <tr>
                    <td class="fw-semibold"><%= a.name %></td>
                    <td>
                      <span class="badge rounded-pill text-capitalize category-chip"
                            style="background:var(--brand-soft);color:var(--brand-ink);font-weight:500;"><%= a.type %></span>
                    </td>
                    <td class="num"><%= a.currency %></td>
                    <td class="text-end num"><%= money(a.balance, a.currency) %></td>
                    <td class="text-end">
                      <a href="/accounts/<%= a.id %>/edit" class="btn btn-sm btn-outline-secondary me-1" aria-label="Edit">
                        <i class="bi bi-pencil"></i>
                      </a>
                      <form action="/accounts/<%= a.id %>/delete" method="POST" class="d-inline"
                            onsubmit="return confirm('Delete account &quot;<%= a.name %>&quot;? This cannot be undone.')">
                        <button class="btn btn-sm btn-outline-danger" aria-label="Delete"><i class="bi bi-trash"></i></button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</div>

<%# views/accounts/form.ejs — shared new/edit form %>
<div class="row justify-content-center">
  <div class="col-md-8 col-lg-6">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h1>
        <i class="bi bi-wallet2"></i>
        <%= account ? 'Edit Account' : 'New Account' %>
      </h1>
      <a href="/accounts" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i> Back
      </a>
    </div>

    <% if (errors && errors.length > 0) { %>
      <div class="alert alert-danger">
        <ul class="mb-0">
          <% errors.forEach(e => { %><li><%= e.msg %></li><% }); %>
        </ul>
      </div>
    <% } %>

    <div class="card">
      <div class="card-body">
        <form action="<%= action %>" method="POST" class="needs-validation" novalidate>
          <div class="mb-3">
            <label for="name" class="form-label">Name *</label>
            <input type="text" name="name" id="name" class="form-control <%= errors && errors.find(e => e.path === 'name') ? 'is-invalid' : '' %>"
                   required maxlength="50"
                   value="<%= oldInput.name || '' %>">
            <% const nameErr = errors && errors.find(e => e.path === 'name'); %>
            <% if (nameErr) { %><div class="invalid-feedback"><%= nameErr.msg %></div><% } %>
          </div>

          <div class="mb-3">
            <label for="type" class="form-label">Type *</label>
            <select name="type" id="type" class="form-select" required>
              <% const selType = oldInput.type || 'cash'; %>
              <option value="cash"    <%= selType === 'cash'    ? 'selected' : '' %>>Cash</option>
              <option value="card"    <%= selType === 'card'    ? 'selected' : '' %>>Card</option>
              <option value="savings" <%= selType === 'savings' ? 'selected' : '' %>>Savings</option>
            </select>
          </div>

          <div class="mb-3">
            <label for="currency" class="form-label">Currency (ISO code)</label>
            <input type="text" name="currency" id="currency"
                   class="form-control <%= errors && errors.find(e => e.path === 'currency') ? 'is-invalid' : '' %>"
                   maxlength="3" placeholder="UAH"
                   value="<%= oldInput.currency || 'UAH' %>"
                   style="text-transform: uppercase">
            <div class="form-text">3-letter ISO code (UAH, USD, EUR, PLN)</div>
            <% const curErr = errors && errors.find(e => e.path === 'currency'); %>
            <% if (curErr) { %><div class="invalid-feedback"><%= curErr.msg %></div><% } %>
          </div>

          <% if (!account) { %>
            <div class="mb-3">
              <label for="balance" class="form-label">Initial balance</label>
              <input type="number" step="0.01" name="balance" id="balance"
                     class="form-control <%= errors && errors.find(e => e.path === 'balance') ? 'is-invalid' : '' %>"
                     value="<%= oldInput.balance || '0' %>">
              <div class="form-text">Starting amount on this account.</div>
              <% const balErr = errors && errors.find(e => e.path === 'balance'); %>
              <% if (balErr) { %><div class="invalid-feedback"><%= balErr.msg %></div><% } %>
            </div>
          <% } else { %>
            <div class="mb-3">
              <label class="form-label">Current balance</label>
              <input type="text" class="form-control" disabled
                     value="<%= account.balance.toFixed(2) %> <%= account.currency %>">
              <div class="form-text">Balance changes automatically via transactions.</div>
            </div>
          <% } %>

          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">
              <i class="bi bi-check2"></i>
              <%= account ? 'Update' : 'Create' %>
            </button>
            <a href="/accounts" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

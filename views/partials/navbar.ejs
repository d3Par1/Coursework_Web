<nav class="navbar navbar-expand-lg border-bottom" style="background:var(--paper)">
  <div class="container">
    <a class="navbar-brand d-flex align-items-center gap-2 fw-bold" href="/">
      <span style="width:28px;height:28px;border-radius:7px;background:var(--brand);
                   color:#fff;display:inline-flex;align-items:center;justify-content:center;
                   font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600;">FM</span>
      <span style="color:var(--ink)">Finance Manager</span>
    </a>
    <button class="navbar-toggler" type="button"
            data-bs-toggle="offcanvas" data-bs-target="#navDrawer"
            aria-controls="navDrawer" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon"></span>
    </button>

    <div class="offcanvas-lg offcanvas-end" tabindex="-1" id="navDrawer"
         aria-labelledby="navDrawerLabel"
         style="background:var(--paper);max-width:300px;">
      <div class="offcanvas-header border-bottom d-lg-none" style="border-color:var(--rule)!important">
        <div id="navDrawerLabel" class="d-flex align-items-center gap-2 fw-bold">
          <span style="width:28px;height:28px;border-radius:7px;background:var(--brand);
                       color:#fff;display:inline-flex;align-items:center;justify-content:center;
                       font-family:'JetBrains Mono',monospace;font-size:12px;font-weight:600;">FM</span>
          <span style="color:var(--ink)">Finance Manager</span>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" data-bs-target="#navDrawer" aria-label="Close"></button>
      </div>

      <div class="offcanvas-body p-lg-0">
        <% if (locals.currentUser) { %>
        <ul class="navbar-nav me-auto">
          <% const items = [
            ['/',             'Dashboard'],
            ['/accounts',     'Accounts'],
            ['/transactions', 'Transactions'],
            ['/categories',   'Categories'],
            ['/budgets',      'Budgets'],
          ];
          const here = locals.currentPath || ''; %>
          <% items.forEach(([href, label]) => {
               const active = here === href; %>
            <li class="nav-item">
              <a class="nav-link <%= active ? 'active fw-semibold' : '' %>"
                 href="<%= href %>"
                 style="color:<%= active ? 'var(--brand)' : 'var(--ink-soft)' %>"><%= label %></a>
            </li>
          <% }); %>
        </ul>
        <% } %>
        <ul class="navbar-nav ms-lg-3 align-items-lg-center mt-3 mt-lg-0">
          <li class="nav-item me-lg-2 mb-2 mb-lg-0">
            <button id="theme-toggle" type="button" class="btn btn-sm"
                    aria-label="Toggle theme" title="Toggle light/dark theme"
                    style="width:32px;height:32px;padding:0;display:inline-flex;align-items:center;justify-content:center;
                           background:var(--surface);border:1px solid var(--rule-strong);color:var(--ink-soft);">
              <i class="bi bi-sun-fill theme-icon-light" aria-hidden="true" style="font-size:14px;"></i>
              <i class="bi bi-moon-stars-fill theme-icon-dark" aria-hidden="true" style="display:none;font-size:14px;"></i>
            </button>
          </li>
          <% if (locals.currentUser) { %>
            <li class="nav-item dropdown user-menu">
              <button class="btn btn-sm user-menu-trigger" type="button"
                      data-bs-toggle="dropdown" aria-expanded="false"
                      aria-label="Account menu">
      <span class="user-menu-avatar">
        <%= initials(currentUser.name) %>
      </span>
                <span class="user-menu-name d-none d-xxl-inline">
        <%= currentUser.name.split(' ').slice(-1)[0] %>
      </span>
                <i class="bi bi-chevron-down user-menu-caret" aria-hidden="true"></i>
              </button>

              <div class="dropdown-menu dropdown-menu-end user-menu-panel">
                <div class="user-menu-header">
                  <div class="user-menu-header-avatar">
                    <%= initials(currentUser.name) %>
                  </div>
                  <div class="user-menu-header-meta">
                    <div class="user-menu-header-name"><%= currentUser.name %></div>
                    <div class="user-menu-header-email"><%= currentUser.email %></div>
                  </div>
                </div>

                <a class="dropdown-item" href="/auth/profile">
                  <i class="bi bi-person-circle" aria-hidden="true"></i>
                  Profile &amp; security
                </a>

                <div class="dropdown-divider"></div>

                <form action="/auth/logout" method="POST" class="user-menu-logout">
                  <button type="submit" class="dropdown-item">
                    <i class="bi bi-box-arrow-right" aria-hidden="true"></i>
                    Sign out
                  </button>
                </form>
              </div>
            </li>
          <% } else { %>
            <li class="nav-item mb-2 mb-lg-0">
              <a class="btn btn-sm btn-outline-secondary me-lg-2" href="/auth/login">Sign in</a>
            </li>
            <li class="nav-item">
              <a class="btn btn-sm btn-primary" href="/auth/register">Create account</a>
            </li>
          <% } %>
        </ul>
      </div>
    </div>
  </div>
</nav>

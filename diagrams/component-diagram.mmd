graph TB
    subgraph Browser["Browser (Client)"]
        BS5["Bootstrap 5<br/>Responsive UI"]
        CJS["Chart.js<br/>Data Visualization"]
        ClientJS["Client JavaScript<br/>Form Validation"]
    end

    subgraph Server["Express 4 Server"]
        subgraph Middleware["Middleware Layer"]
            Session["express-session"]
            Flash["connect-flash"]
            Validator["express-validator"]
            Morgan["morgan (Logger)"]
            BodyParser["Body Parser<br/>(urlencoded + JSON)"]
        end

        subgraph Routes["Routes Layer"]
            AuthR["Auth Routes<br/>/auth/*"]
            DashR["Dashboard Routes<br/>/"]
            AccR["Account Routes<br/>/accounts/*"]
            TxnR["Transaction Routes<br/>/transactions/*"]
            CatR["Category Routes<br/>/categories/*"]
            BudR["Budget Routes<br/>/budgets/*"]
        end

        subgraph Models["Models Layer"]
            UserM["User Model"]
            AccM["Account Model"]
            TxnM["Transaction Model"]
            CatM["Category Model"]
            BudM["Budget Model"]
        end

        subgraph Views["Views Layer (EJS)"]
            Layout["layout.ejs<br/>Master Template"]
            Partials["Partials<br/>(navbar, flash, footer)"]
            Pages["Page Templates<br/>(dashboard, accounts,<br/>transactions, etc.)"]
        end
    end

    subgraph DB["SQLite Database"]
        Schema["5 Tables<br/>(users, accounts, categories,<br/>transactions, budgets)"]
    end

    subgraph External["External Services (Phase 6)"]
        ExRate["ExchangeRate API<br/>Currency Conversion"]
        Gmail["Gmail SMTP<br/>Email Notifications"]
    end

    Browser -->|"HTTP Requests"| Middleware
    Middleware --> Routes
    Routes --> Models
    Routes --> Views
    Models -->|"SQL Queries<br/>(better-sqlite3)"| DB
    Views --> Browser
    Server -.->|"HTTP API"| ExRate
    Server -.->|"SMTP"| Gmail

    classDef client fill:#4a90d9,stroke:#2c5282,color:#fff
    classDef server fill:#48bb78,stroke:#276749,color:#fff
    classDef middleware fill:#ed8936,stroke:#c05621,color:#fff
    classDef db fill:#9f7aea,stroke:#6b46c1,color:#fff
    classDef external fill:#a0aec0,stroke:#718096,color:#fff

    class BS5,CJS,ClientJS client
    class AuthR,DashR,AccR,TxnR,CatR,BudR,UserM,AccM,TxnM,CatM,BudM,Layout,Partials,Pages server
    class Session,Flash,Validator,Morgan,BodyParser middleware
    class Schema db
    class ExRate,Gmail external

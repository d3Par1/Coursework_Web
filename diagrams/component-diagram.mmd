graph TD
    subgraph Client["Browser (Client)"]
        direction LR
        BS5["Bootstrap 5\nResponsive UI"]
        CJS["Chart.js\nVisualization"]
        ClientJS["Client JS\nValidation"]
    end

    subgraph Server["Express 4 Server"]
        direction LR
        subgraph MW["Middleware"]
            direction LR
            Session["express-session"] --- Flash["connect-flash"]
            Flash --- Valid["express-validator"]
            Valid --- Morgan["morgan"]
            Morgan --- BP["Body Parser"]
        end

        subgraph RT["Routes"]
            direction LR
            AuthR["/auth"] --- DashR["/"]
            DashR --- AccR["/accounts"]
            AccR --- TxnR["/transactions"]
            TxnR --- CatR["/categories"]
            CatR --- BudR["/budgets"]
        end

        subgraph VW["Views (EJS)"]
            direction LR
            Layout["layout.ejs"] --- Parts["Partials\nnavbar, flash, footer"]
            Parts --- Pages["Page Templates"]
        end

        subgraph MD["Models"]
            direction LR
            UserM["User"] --- AccM["Account"]
            AccM --- TxnM["Transaction"]
            TxnM --- CatM["Category"]
            CatM --- BudM["Budget"]
        end
    end

    subgraph DB["SQLite Database (better-sqlite3)"]
        Tables["users | accounts | categories | transactions | budgets"]
    end

    subgraph Ext["External Services (Phase 6)"]
        direction LR
        ExRate["ExchangeRate API"] --- Gmail["Gmail SMTP"]
    end

    Client -->|"HTTP Requests"| MW
    MW --> RT
    RT --> VW
    RT --> MD
    VW -->|"HTML Response"| Client
    MD -->|"SQL Queries"| DB
    Server -.->|"HTTP / SMTP"| Ext

    classDef client fill:#4a90d9,stroke:#2c5282,color:#fff
    classDef server fill:#48bb78,stroke:#276749,color:#fff
    classDef mw fill:#ed8936,stroke:#c05621,color:#fff
    classDef db fill:#9f7aea,stroke:#6b46c1,color:#fff
    classDef ext fill:#a0aec0,stroke:#718096,color:#fff

    class BS5,CJS,ClientJS client
    class AuthR,DashR,AccR,TxnR,CatR,BudR server
    class UserM,AccM,TxnM,CatM,BudM server
    class Layout,Parts,Pages server
    class Session,Flash,Valid,Morgan,BP mw
    class Tables db
    class ExRate,Gmail ext

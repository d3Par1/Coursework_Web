PORT=3000
DB_PATH=./finance.db
SESSION_SECRET=change-me-in-production

# ── OAuth providers (all optional) ──────────────────────────────────────────
# Leave any of these unset to disable the corresponding sign-in option.
# The UI buttons and callback routes turn off automatically.

# Google OAuth — get values from https://console.cloud.google.com/
# Authorized redirect URI for local dev:  http://localhost:3000/auth/google/callback
# Authorized redirect URI for Render:     https://YOUR-APP.onrender.com/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional explicit callback base (otherwise the URL is relative and
# Google infers it from the redirect_uri). Set to your Render URL in prod.
OAUTH_CALLBACK_BASE=

# Telegram Login Widget — create a bot with @BotFather, then run:
#   /setdomain  →  finance-app-p6gg.onrender.com   (the domain hosting the widget)
# TELEGRAM_BOT_USERNAME is the bot's @handle without the @ sign.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
